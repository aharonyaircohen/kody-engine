{
  "$schema": "./kody.config.schema.json",
  "agent": {
    "model": "openrouter/free"
  },
  "github": {
    "owner": "aharonyaircohen",
    "repo": "kody-engine"
  },
  "git": {
    "defaultBranch": "main"
  },
  "quality": {
    "typecheck": "pnpm typecheck",
    "testUnit": "if [ ! -d ../kody-store/.git ]; then git clone --depth 1 --branch main https://github.com/aharonyaircohen/kody-ai-agency-catalog.git ../kody-store; fi && pnpm test",
    "coverage": "pnpm tsx scripts/check-coverage-floor.ts"
  },
  "release": {
    "validation": {
      "workflow": "ci.yml"
    },
    "versionFiles": [
      "package.json"
    ],
    "productionDeployRequired": false,
    "timeoutMs": 1800000
  },
  "company": {
    "activeCapabilities": [
      "ci-health-check",
      "fix",
      "merge",
      "npm-publish",
      "release-merge",
      "release-prepare",
      "release-promote",
      "release-validate",
      "review",
      "run",
      "test-health-check",
      "vercel-production-deploy",
      "repo-source-health",
      "observe-repo-ci",
      "observe-agency-flow"
    ],
    "activeWorkflows": [
      "package-release",
      "test-health",
      "web-release",
      "agency-observer",
      "ci-repair"
    ],
    "activeAgents": [
      "kody"
    ]
  }
}
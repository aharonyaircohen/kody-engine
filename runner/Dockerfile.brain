FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    NODE_ENV=production

RUN apt-get update && apt-get install -y --no-install-recommends \
      git \
      ca-certificates \
      curl \
      python3 \
      python3-pip \
      python3-venv \
      jq \
      openssh-client \
      socat \
    && rm -rf /var/lib/apt/lists/*

# GitHub CLI — the chat loop's bash tool shells out to `gh` for issue/PR
# context. Same pin as the runner image.
ARG GH_VERSION=2.62.0
RUN ARCH=$(dpkg --print-architecture) \
 && curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${ARCH}.tar.gz" \
    | tar -xz -C /tmp \
 && mv "/tmp/gh_${GH_VERSION}_linux_${ARCH}/bin/gh" /usr/local/bin/gh \
 && rm -rf "/tmp/gh_${GH_VERSION}_linux_${ARCH}"

RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/venv/bin/pip install --no-cache-dir 'litellm[proxy]==1.93.0' 'hermes-agent'
ENV PATH="/opt/venv/bin:${PATH}"

# Install from git so unreleased changes (e.g. the brain-serve executable
# itself) are available before the next npm publish. Pin via KODY_ENGINE_REF
# for reproducibility. We build inside the image because `npm install
# git+...` does NOT trigger the package's `prepublishOnly` hook, so dist/
# would otherwise be empty and the `kody` bin would be missing. Once
# brain-serve lands in a published version this can revert to
# `npm install -g @kody-ade/kody-engine@<version>`.
ARG KODY_ENGINE_REF=main
# Build → pack → install via tarball. `npm install -g /local/path` on a
# pnpm-managed repo doesn't reliably include the dist/ directory at the
# install root (the file made it into the layer at build time but not into
# the installed package). Going through `npm pack` honors the package's
# `files` field deterministically, and `npm install -g <tarball>` then
# behaves the same way a published package would.
RUN corepack enable \
 && git clone --depth=1 --branch "${KODY_ENGINE_REF}" \
      https://github.com/aharonyaircohen/kody-engine.git /tmp/kody-engine \
 && cd /tmp/kody-engine \
 && pnpm install --frozen-lockfile --ignore-scripts \
 && pnpm build \
 && test -f dist/bin/kody.js \
 && PKG_TARBALL="$(npm pack --silent)" \
 && npm install -g "/tmp/kody-engine/$PKG_TARBALL" \
 && test -f /usr/local/lib/node_modules/@kody-ade/kody-engine/dist/bin/kody.js \
 && node /usr/local/lib/node_modules/@kody-ade/kody-engine/dist/bin/kody.js version \
 && rm -rf /tmp/kody-engine

# Package managers — same rationale as the runner: chat loop can run repo
# scripts, so pnpm/yarn/npm need to be on PATH.
RUN corepack enable \
 && corepack prepare pnpm@latest --activate

WORKDIR /workspace

COPY entrypoint-brain.sh /usr/local/bin/entrypoint-brain.sh
RUN chmod +x /usr/local/bin/entrypoint-brain.sh

# Brain server defaults to 8080. Fly's `services` config maps :80/:443 →
# this internal port. Exposing here is informational; Fly reads ports from
# its own config.
EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/entrypoint-brain.sh"]

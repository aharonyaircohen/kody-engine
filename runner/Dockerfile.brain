FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    NODE_ENV=production

RUN apt-get update && apt-get install -y --no-install-recommends \
      git \
      ca-certificates \
      curl \
      python3 \
      python3-pip \
      python3-venv \
      jq \
      openssh-client \
      socat \
    && rm -rf /var/lib/apt/lists/*

# GitHub CLI — the chat loop's bash tool shells out to `gh` for issue/PR
# context. Same pin as the runner image.
ARG GH_VERSION=2.62.0
RUN ARCH=$(dpkg --print-architecture) \
 && curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${ARCH}.tar.gz" \
    | tar -xz -C /tmp \
 && mv "/tmp/gh_${GH_VERSION}_linux_${ARCH}/bin/gh" /usr/local/bin/gh \
 && rm -rf "/tmp/gh_${GH_VERSION}_linux_${ARCH}"

RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/venv/bin/pip install --no-cache-dir 'litellm[proxy]'
ENV PATH="/opt/venv/bin:${PATH}"

ARG KODY_ENGINE_VERSION=latest
RUN npm install -g @kody-ade/kody-engine@${KODY_ENGINE_VERSION}

# Package managers — same rationale as the runner: chat loop can run repo
# scripts, so pnpm/yarn/npm need to be on PATH.
RUN corepack enable \
 && corepack prepare pnpm@latest --activate

WORKDIR /workspace

COPY entrypoint-brain.sh /usr/local/bin/entrypoint-brain.sh
RUN chmod +x /usr/local/bin/entrypoint-brain.sh

# Brain server defaults to 8080. Fly's `services` config maps :80/:443 →
# this internal port. Exposing here is informational; Fly reads ports from
# its own config.
EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/entrypoint-brain.sh"]

{
  "name": "capability-run",
  "internal": true,
  "role": "primitive",
  "kind": "oneshot",
  "inputs": [
    {
      "name": "capability",
      "flag": "--capability",
      "type": "string",
      "required": true,
      "describe": "Capability folder slug."
    },
    {
      "name": "input",
      "flag": "--input",
      "type": "string",
      "required": false,
      "bindsCommentRest": true,
      "describe": "The capability's single JSON input."
    }
  ],
  "claudeCode": {
    "model": "inherit",
    "permissionMode": "acceptEdits",
    "maxTurns": 60,
    "maxThinkingTokens": null,
    "systemPromptAppend": null,
    "tools": ["Read", "Bash", "Edit", "Write", "Glob", "Grep"],
    "hooks": [],
    "skills": [],
    "commands": [],
    "subagents": [],
    "plugins": [],
    "mcpServers": []
  },
  "cliTools": [],
  "scripts": {
    "preflight": [
      { "script": "loadSimpleCapability" },
      {
        "script": "prepareSimpleCapabilityRuntime",
        "runWhen": { "data.capabilityExecution": "agent" }
      },
      {
        "script": "runSimpleCapabilityScript",
        "runWhen": { "data.capabilityExecution": "script" }
      }
    ],
    "postflight": [
      { "script": "parseSimpleCapabilityOutput" },
      { "script": "publishReport" }
    ]
  },
  "inputArtifacts": [],
  "outputArtifacts": []
}

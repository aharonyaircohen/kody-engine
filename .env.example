# kody-engine — local/dev environment.
# Copy to .env and fill in. .env is gitignored. NEVER commit real keys.
# In CI these come from GitHub Actions secrets/variables, not this file.

# ── Model provider (at least one required) ──────────────────────────
# Anthropic-native — no proxy needed.
# ANTHROPIC_API_KEY=sk-ant-...

# Any other provider routes through the built-in LiteLLM proxy.
# Set MODEL to the provider/model id your kody.config.json expects.
# MODEL=anthropic/claude-opus-4-8

# ── GitHub access ───────────────────────────────────────────────────
# kody talks to GitHub only via the `gh` CLI. Provide a token for it.
# GH_TOKEN=ghp_...
# GH_PAT=ghp_...          # preferred — a dedicated PAT scoped to the repo
# KODY_TOKEN=ghp_...      # optional PAT so kody's commits trigger downstream CI

# Git identity used for kody's commits (CI only).
# GIT_AUTHOR_NAME=kody-bot
# GIT_AUTHOR_EMAIL=bot@example.com

# ── LiteLLM proxy (only for non-Anthropic models) ───────────────────
# KODY_LITELLM_URL=http://localhost:4000
# KODY_MASTER_KEY=sk-litellm-...

# ── UI-review / qa-engineer (optional) ──────────────────────────────
# PREVIEW_URL=http://localhost:3000
# LOGIN_PASSWORD=...      # password for an authed QA route (username is a kody variable)

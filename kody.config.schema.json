{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kody Engine Configuration",
  "description": "Configuration for @kody-ade/kody-engine consumer repositories.",
  "type": "object",
  "required": ["github", "agent"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "quality": {
      "type": "object",
      "description": "Quality gate commands. Empty strings disable individual gates.",
      "additionalProperties": false,
      "properties": {
        "typecheck": { "type": "string", "default": "" },
        "lint": { "type": "string", "default": "" },
        "format": { "type": "string", "default": "" },
        "testUnit": { "type": "string", "default": "" }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultBranch": {
          "type": "string",
          "description": "Default branch for PR base and branch syncing.",
          "default": "main"
        }
      }
    },
    "brain": {
      "type": "object",
      "description": "Brain backend selection. 'brain-serve' is the engine's built-in Node.js brain; 'hermes' is the Hermes Agent API server. The entrypoint reads brain.mode on boot and exports it as BRAIN_BACKEND for the brain-proxy. BRAIN_BACKEND env var on the Fly Machine overrides this config (dev/CI escape hatch).",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["brain-serve", "hermes"],
          "default": "brain-serve",
          "description": "Which brain backend the proxy routes to. Overridden by BRAIN_BACKEND env var."
        }
      }
    },
    "github": {
      "type": "object",
      "required": ["owner", "repo"],
      "additionalProperties": false,
      "properties": {
        "owner": { "type": "string" },
        "repo": { "type": "string" }
      }
    },
    "state": {
      "type": "object",
      "description": "External repository and path used for Kody runtime state.",
      "additionalProperties": false,
      "properties": {
        "repo": {
          "type": "string",
          "description": "Full GitHub repository URL for Kody runtime state.",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:\\.git)?$"
        },
        "path": {
          "type": "string",
          "description": "Folder inside state.repo that belongs to this consumer repo."
        }
      }
    },
    "agent": {
      "type": "object",
      "required": ["model"],
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "pattern": "^[^/]+/.+$",
          "description": "Base provider/model string, for example minimax/MiniMax-M3 or claude/claude-sonnet-4-6."
        },
        "reasoningEffort": {
          "type": "string",
          "enum": ["off", "low", "medium", "high"],
          "description": "Default thinking effort for the Claude Agent SDK. Maps to maxThinkingTokens. 'off' (default) skips the thinking block entirely — no reasoning preamble, no extra tokens. 'low'/'medium'/'high' enable extended thinking with budgets 2_048/10_000/32_000. Overridable per-session via the REASONING_EFFORT env var or the dashboard's chat-level thinking dropdown."
        },
        "perAgentAction": {
          "type": "object",
          "description": "Optional provider/model override by agentAction name.",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[^/]+/.+$"
          }
        }
      }
    },
    "issueContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commentLimit": {
          "type": "integer",
          "minimum": 1
        },
        "commentMaxBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "testRequirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pattern", "requireSibling"],
        "additionalProperties": false,
        "properties": {
          "pattern": { "type": "string" },
          "requireSibling": { "type": "string" }
        }
      }
    },
    "defaultAgentAction": {
      "type": "string",
      "description": "AgentAction used for bare @kody comments on issues.",
      "default": "run"
    },
    "defaultPrAgentAction": {
      "type": "string",
      "description": "Optional agentAction used for bare @kody comments on PRs. Leave unset to require explicit PR commands."
    },
    "onPullRequest": {
      "type": "string",
      "description": "Optional agentAction to run on pull_request opened, synchronize, or reopened events."
    },
    "aliases": {
      "type": "object",
      "description": "Comment subcommand aliases, mapping typed word to agentAction name.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "classify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "labelMap": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "versionFiles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "publishCommand": { "type": "string" },
        "notifyCommand": { "type": "string" },
        "e2eCommand": { "type": "string" },
        "draftRelease": { "type": "boolean" },
        "releaseBranch": { "type": "string" },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "jobs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stateBackend": {
          "type": "string",
          "enum": ["contents-api"],
          "default": "contents-api"
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowedAssociations": {
          "type": "array",
          "description": "GitHub author_association values allowed to trigger @kody. Empty array disables the gate.",
          "items": {
            "type": "string",
            "enum": [
              "OWNER",
              "MEMBER",
              "COLLABORATOR",
              "CONTRIBUTOR",
              "FIRST_TIME_CONTRIBUTOR",
              "FIRST_TIMER",
              "MANNEQUIN",
              "NONE"
            ]
          },
          "default": ["OWNER", "MEMBER", "COLLABORATOR"]
        }
      }
    }
  }
}
